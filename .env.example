# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API Keys in your Supabase dashboard.
# Supabase is retiring the legacy `anon` / `service_role` JWT keys by end of
# 2026 — create the "Publishable and secret API keys" and use those.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_…). Safe in the browser; RLS governs access.
# Legacy equivalent: the `anon` key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key (sb_secret_…). SERVER ONLY — bypasses RLS. Never prefix with
# NEXT_PUBLIC_. Legacy equivalent: the `service_role` key.
SUPABASE_SECRET_KEY=sb_secret_xxx

# ── App ─────────────────────────────────────────────────────────────────────
# The public URL of the deployed app (Vercel domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Chapter settings ────────────────────────────────────────────────────────
# Email domain used for track login accounts (e.g. front-end-development@this-domain)
TRACK_EMAIL_DOMAIN=cics.benisuef.ieee
# Password assigned to newly created track logins (each is resettable in the admin panel)
TRACK_DEFAULT_PASSWORD=ChangeMe123!
# IANA timezone that defines the "queue day" — stored in the DB (app_settings), shown here for reference
QUEUE_TIMEZONE=Africa/Cairo
